# Copy to .env in the repository root. Keys stay on the Python server.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Optional model for converting uploaded files; blank uses GEMINI_MODEL. Free-tier quotas are per model.
GEMINI_CONVERT_MODEL=
# One to six comparison agents. The UI uses them when every required key is set,
# and automatically falls back to three simulated agents otherwise.
WORKER_PROVIDERS=openai,gemini,openai
# Leave blank to use provider defaults, or supply one model per worker.
WORKER_MODELS=
# Optional blended USD estimates per 1,000 tokens, one per worker; blank means unknown.
WORKER_COST_PER_1K_TOKENS=,,
TRADER_PROVIDER=gemini
ANALYST_PROVIDER=gemini
# Optional model overrides for these roles:
TRADER_MODEL=
ANALYST_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
# Optional TigerData Postgres connection string; blank uses local SQLite.
# Use your service's supplied TLS settings. Never commit a real URL containing credentials.
DATABASE_URL=
# Benchmark planning uses Ollama on 127.0.0.1:11434.
# Answer judging prefers GEMINI_API_KEY and falls back to this local model.
# Install the configured model with ollama pull.
OLLAMA_MODEL=qwen2.5:7b
# Local workers: set WORKER_PROVIDERS to one to six ollama entries and set matching WORKER_MODELS,
# plus TRADER_PROVIDER=ollama and ANALYST_PROVIDER=ollama. Use a custom dataset.
# Disable cloud in the Ollama server itself with OLLAMA_NO_CLOUD=1 and restart it.
