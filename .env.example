# Copy to .env in the repository root. Keys stay on the Python server.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Optional model for converting uploaded files; blank uses GEMINI_MODEL. Free-tier quotas are per model.
GEMINI_CONVERT_MODEL=
# Atlas / Nova / Orbit. Use anthropic for Orbit to add Claude.
WORKER_PROVIDERS=openai,gemini,openai
# Leave blank to use each provider's default model; or supply three comma-separated models.
WORKER_MODELS=
# Optional blended USD estimates per 1,000 tokens, one per worker; blank means unknown.
WORKER_COST_PER_1K_TOKENS=,,
# Traders and the round summary are seeded locally and make no model calls,
# so they need no provider, no model and no key.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
# Optional TigerData Postgres connection string; blank uses local SQLite.
# Use your service's supplied TLS settings. Never commit a real URL containing credentials.
DATABASE_URL=
# Local inference and benchmark-metric drafting through Ollama on 127.0.0.1:11434.
# Install models with ollama pull. Also used when Gemini has no key or returns HTTP 429.
OLLAMA_MODEL=qwen2.5:7b
# Gemini is preferred for evaluation; missing keys and rate limits use OLLAMA_MODEL.
# Avoid using the evaluator model as a worker; it would grade itself.
# Local workers: set WORKER_PROVIDERS=ollama,ollama,ollama and all three WORKER_MODELS.
# Ollama also grades when Gemini is unavailable. Use a custom dataset.
# Disable cloud in the Ollama server itself with OLLAMA_NO_CLOUD=1 and restart it.
